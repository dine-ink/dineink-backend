# Copy to .env and fill in. Never commit the real .env.

# ─── Core ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dineink
JWT_SECRET=
PORT=5500

# Verifies the RDS server certificate. Without it the connection is encrypted
# but unverified. Download: https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
DATABASE_CA_CERT=
# SLOW_QUERY_MS=200

# ─── Frontend origins ────────────────────────────────────────────────────────
OWNER_WEB_URL=http://localhost:5173
POS_URL=http://localhost:5174
# The internal operations console. Used in password-reset links.
INTERNAL_WEB_URL=http://localhost:5175

# ─── Email (SendGrid) ────────────────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# ─── AI ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ══════════════════════════════════════════════════════════════════════════════
# INTERNAL OPERATIONS CONSOLE
# ══════════════════════════════════════════════════════════════════════════════

# Signs internal employee session tokens. A dedicated secret is strongly
# preferred so an internal token and a restaurant token are not even
# cryptographically interchangeable. Falls back to JWT_SECRET if unset — still
# safe on its own, because every internal token is matched against a session row
# that only the internal login creates, but set this properly in production.
INTERNAL_JWT_SECRET=

# Base URL a scanned table QR points at. Table QRs encode an unguessable random
# token, never the table's database id.
CUSTOMER_ORDER_URL=https://order.dineink.com

# ─── Jira (support escalation) ───────────────────────────────────────────────
# Without these, escalation still works and is recorded — the ticket is marked
# escalated and an issue key can be linked by hand. Nothing fails silently.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
# JIRA_ISSUE_TYPE=Bug
# Jira priority names differ per site; override if yours aren't the defaults.
# JIRA_PRIORITY_CRITICAL=Highest
# JIRA_PRIORITY_HIGH=High
# JIRA_PRIORITY_MEDIUM=Medium
# JIRA_PRIORITY_LOW=Low

# ─── First-run bootstrap ─────────────────────────────────────────────────────
# Used only by `npx tsx scripts/seed-internal-rbac.ts` to create the first Super
# Admin. The password is generated and printed once, not read from here.
# INTERNAL_BOOTSTRAP_EMAIL=you@dineink.com
# INTERNAL_BOOTSTRAP_NAME=Your Name
