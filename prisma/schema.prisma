// Schema updated - run: npx prisma migrate dev
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BillStatus {
  UNPAID
  PAID
  PARTIAL
  CANCELLED
}

model Restaurant {
  id                       Int                       @id @default(autoincrement())
  name                     String
  email                    String?
  phone                    String?
  address                  String?
  gstNumber                String?
  insights                 RestaurantInsights[]
  ownerId                  Int?
  owner                    User?                     @relation("RestaurantOwner", fields: [ownerId], references: [id])
  users                    User[]                    @relation("RestaurantUsers")
  vendors                  Vendor[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  inventoryRestocks        InventoryRestock[]
  branches                 Branch[]
  categories               Category[]
  menuItems                MenuItem[]
  customers                Customer[]
  bills                    Bill[]
  runningOrders            RunningOrder[]
  logo                     String?
  ingredientCategories     IngredientCategory[]
  ingredients              Ingredient[]
  attendances              Attendance[]
  dailyCashSessions        DailyCashSession[]
  shopExpenses             ShopExpense[]
  inventoryAdjustments     InventoryAdjustment[]
  vendorPayments           VendorPayment[]
  vendorInvoices           VendorInvoice[]
  ingredientPriceHistories IngredientPriceHistory[]
  dailyStockAudits         DailyStockAudit[]
  sopChecklists            SopChecklist[]
  addOnGroups              AddOnGroup[]
  discountCodes            DiscountCode[]
  financialAssumptions     FinancialAssumptions[]
  budgets                  Budget[]
  financialScenarios       FinancialScenario[]
  financialForecasts       FinancialForecast[]
  investmentProjects       InvestmentProject[]
  executiveKpiTargets      ExecutiveKpiTarget[]
  userDashboardPreferences UserDashboardPreference[]
  aiInsightLogs            AIInsightLog[]
  emiSchedules             EmiSchedule[]
  equipment                Equipment[]
  complianceRecords        ComplianceRecord[]
  monthlyDues              MonthlyDue[]
  whatsAppMessageLogs      WhatsAppMessageLog[]
  whatsAppTemplates        WhatsAppTemplate[]
  leaveRequests            LeaveRequest[]
  salaryDeductions         SalaryDeduction[]
  payrollRuns              PayrollRun[]
  bankAccounts             BankAccount[]
  upiConfigs               UpiConfig[]
  bankTransactionEntries   BankTransactionEntry[]
  kitchenStations          KitchenStation[]

  @@index([ownerId])
}

model Branch {
  id           Int      @id @default(autoincrement())
  name         String
  address      String?
  phone        String?
  email        String?
  restaurantId Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  city         String?
  state        String?
  pincode      String?
  openingTime  String? // "HH:mm" 24hr — used to compute the staff late-arrival cutoff
  closingTime  String? // "HH:mm" 24hr — used for the after-closing daily stock audit reminder

  // Payroll policy: standard hours per shift type, used to derive an hourly
  // rate from a staff member's monthly salary (salary / (30 * standardHours
  // for their shift)), and the overtime pay multiplier applied to
  // Attendance.overtimeHours. All owner-configurable per branch.
  morningShiftHours      Float? @default(6)
  eveningShiftHours      Float? @default(6)
  fullDayShiftHours      Float? @default(10)
  overtimeRateMultiplier Float? @default(1.5)

  // Floor area, for Sales per Sq. Ft. (Annual Sales / area).
  areaSqFt Float?

  menuItems              MenuItem[]
  tables                 RestaurantTable[]
  isActive               Boolean                @default(true)
  restaurant             Restaurant             @relation(fields: [restaurantId], references: [id])
  users                  User[]
  bills                  Bill[]
  runningOrders          RunningOrder[]
  isDeleted              Boolean                @default(false)
  inventoryRestocks      InventoryRestock[]
  vendors                Vendor[]
  billing                BillingSettings?
  insights               RestaurantInsights[]
  ingredientVendors      IngredientVendor[]
  attendances            Attendance[]
  dailyCashSessions      DailyCashSession[]
  shopExpenses           ShopExpense[]
  inventoryAdjustments   InventoryAdjustment[]
  vendorPayments         VendorPayment[]
  vendorInvoices         VendorInvoice[]
  dailyStockAudits       DailyStockAudit[]
  sopChecklists          SopChecklist[]
  financialAssumptions   FinancialAssumptions[]
  budgets                Budget[]
  financialScenarios     FinancialScenario[]
  financialForecasts     FinancialForecast[]
  investmentProjects     InvestmentProject[]
  executiveKpiTargets    ExecutiveKpiTarget[]
  aiInsightLogs          AIInsightLog[]
  emiSchedules           EmiSchedule[]
  equipment              Equipment[]
  complianceRecords      ComplianceRecord[]
  monthlyDues            MonthlyDue[]
  whatsAppMessageLogs    WhatsAppMessageLog[]
  leaveRequests          LeaveRequest[]
  salaryDeductions       SalaryDeduction[]
  payrollRuns            PayrollRun[]
  bankAccounts           BankAccount[]
  upiConfigs             UpiConfig[]
  bankTransactionEntries BankTransactionEntry[]
  kitchenStations        KitchenStation[]

  // Kitchen capacity policy for Peak Hour Depletion — hourly order-count
  // ceiling used for bottleneck detection, and whether exceeding it should
  // flag new orders for a manual hold suggestion (never a silent auto-reject).
  kitchenCapacityPerHour Int?
  autoThrottleEnabled    Boolean @default(false)

  // Labor & Capacity Engine policy. staffUtilizationFactor is the branch-wide
  // default fraction of a clock hour a kitchen staff member is actually
  // producing food (the rest goes to walking, cleaning, fetching ingredients,
  // coordination, task switching) — a KitchenStation may override it. Applied
  // as: productive minutes per staff per hour = 60 * factor.
  //
  // targetTicketMinutes is the service-level target the staffing plan is
  // solved against. Deliberately NOT wired into the pre-existing 30-minute
  // SLA_MINUTES in analyticsAdvanced.service.ts / Kitchen Analytics — that
  // constant defines the historical "SLA Compliance %" metric and changing
  // its basis would silently rewrite every past SLA number an owner has
  // already seen. This field governs the labor engine only.
  staffUtilizationFactor Float? @default(0.75)
  targetTicketMinutes    Int?   @default(30)

  @@index([restaurantId])
}

model User {
  id                          Int                      @id @default(autoincrement())
  name                        String
  email                       String?                  @unique
  password                    String
  hasLogin                    Boolean                  @default(false)
  role                        String
  phone                       String?                  @unique
  restaurantId                Int?
  branchId                    Int?
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  isActive                    Boolean                  @default(true)
  isDeleted                   Boolean                  @default(false)
  restaurant                  Restaurant?              @relation("RestaurantUsers", fields: [restaurantId], references: [id])
  ownedRestaurants            Restaurant[]             @relation("RestaurantOwner")
  branch                      Branch?                  @relation(fields: [branchId], references: [id])
  salary                      Float?
  joiningDate                 DateTime?
  shift                       String?
  employmentType              String?
  monthlyWorkingHours         Float?
  department                  String?
  attendances                 Attendance[]
  paidExpenses                ShopExpense[]            @relation("ExpensePaidByUser")
  inventoryAdjustmentsUpdated InventoryAdjustment[]    @relation("InventoryUpdatedBy")
  financialAssumptionsUpdated FinancialAssumptions[]   @relation("FinancialAssumptionsUpdatedBy")
  budgetsCreated              Budget[]                 @relation("BudgetCreatedBy")
  budgetsUpdated              Budget[]                 @relation("BudgetUpdatedBy")
  financialScenariosCreated   FinancialScenario[]      @relation("FinancialScenarioCreatedBy")
  financialScenariosUpdated   FinancialScenario[]      @relation("FinancialScenarioUpdatedBy")
  financialForecastsCreated   FinancialForecast[]      @relation("FinancialForecastCreatedBy")
  investmentProjectsCreated   InvestmentProject[]      @relation("InvestmentProjectCreatedBy")
  executiveKpiTargetsUpdated  ExecutiveKpiTarget[]     @relation("ExecutiveKpiTargetUpdatedBy")
  whatsAppTemplatesCreated    WhatsAppTemplate[]       @relation("WhatsAppTemplateCreatedBy")
  dashboardPreference         UserDashboardPreference?
  leaveRequests               LeaveRequest[]
  salaryDeductions            SalaryDeduction[]
  payrollRunLines             PayrollRunLine[]
  stationSkills               StaffStationSkill[]
}

model EmailOtp {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  otpHash   String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetOtp {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  otpHash   String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Category {
  id           Int        @id @default(autoincrement())
  name         String
  icon         String?
  restaurantId Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  menuItems    MenuItem[]
  isDeleted    Boolean    @default(false)

  @@index([restaurantId])
}

model BillingSettings {
  id                        Int      @id @default(autoincrement())
  branchId                  Int      @unique
  billingTypes              String[]
  gstPercentage             Float
  serviceCharge             Float
  includeGST                Boolean
  enableDiscount            Boolean
  enableTips                Boolean
  paymentMethods            String[]
  // Manual (non-coupon) discounts above this % of the subtotal require a
  // manager's password to unlock at checkout. Null = use the service-layer
  // default (20%) rather than forcing every branch to set one explicitly.
  discountApprovalThreshold Float?
  branch                    Branch   @relation(fields: [branchId], references: [id])
}

// A restaurant-wide coupon/promo code — % or flat-amount off, optionally
// capped by uses or an expiry date. Applied at checkout in place of (not in
// addition to) a manual discount.
model DiscountCode {
  id           Int       @id @default(autoincrement())
  restaurantId Int
  code         String
  type         String // "PERCENTAGE" | "FIXED"
  value        Float
  isActive     Boolean   @default(true)
  maxUses      Int?
  usedCount    Int       @default(0)
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@unique([restaurantId, code])
  @@index([restaurantId])
}

model MenuItem {
  id                  Int                  @id @default(autoincrement())
  name                String
  description         String?
  price               Float
  prepTime            Int                  @default(0)
  restaurantId        Int
  branchId            Int?
  type                String?
  categoryId          Int?
  isAvailable         Boolean              @default(true)
  isDeleted           Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  restaurant          Restaurant           @relation(fields: [restaurantId], references: [id])
  branch              Branch?              @relation(fields: [branchId], references: [id])
  category            Category?            @relation(fields: [categoryId], references: [id])
  menuItemIngredients MenuItemIngredient[]
  sopChecklists       SopChecklist[]
  addOnGroups         MenuItemAddOnGroup[]
  stationTimes        MenuItemStationTime[]

  @@index([restaurantId])
  @@index([branchId])
}

// ─── Add-Ons (modifiers) ──────────────────────────────────────────────────────
// Reusable, optional/multi-select groups (e.g. "Extra Toppings") defined once
// per restaurant and attached to whichever menu items they apply to, rather
// than re-entering the same options ("Extra Cheese ₹40") on every item.
// Deliberately additive-only pricing — required single-select variants (e.g.
// Small/Medium/Large, where each size has its own absolute price rather than
// adding to a base price) are a different pricing model and out of scope here.

model AddOnGroup {
  id           Int      @id @default(autoincrement())
  restaurantId Int
  name         String // e.g. "Extra Toppings"
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant           @relation(fields: [restaurantId], references: [id])
  options    AddOn[]
  menuItems  MenuItemAddOnGroup[]

  @@index([restaurantId])
}

model AddOn {
  id           Int      @id @default(autoincrement())
  addOnGroupId Int
  name         String // e.g. "Extra Cheese"
  price        Float
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addOnGroup AddOnGroup @relation(fields: [addOnGroupId], references: [id], onDelete: Cascade)

  @@index([addOnGroupId])
}

model MenuItemAddOnGroup {
  id           Int @id @default(autoincrement())
  menuItemId   Int
  addOnGroupId Int

  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  addOnGroup AddOnGroup @relation(fields: [addOnGroupId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, addOnGroupId])
  @@index([menuItemId])
  @@index([addOnGroupId])
}

model Customer {
  id           Int        @id @default(autoincrement())
  name         String
  // Scoped per restaurant, not globally unique — a phone number can be a
  // real customer at more than one independent restaurant. A bare global
  // @unique here previously meant the checkout upsert (which matched on
  // phone alone) could silently attach one restaurant's existing Customer
  // row — name, address, visit history — to a bill placed at a completely
  // different restaurant the first time the two happened to share a phone
  // number. Confirmed via a live production check that no rows have
  // actually collided yet (0 phones shared across restaurants as of this
  // fix), so this tightening needed no data backfill.
  phone        String
  email        String?
  address      String?
  restaurantId Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  bills        Bill[]

  @@unique([restaurantId, phone])
}

model Bill {
  id            Int    @id @default(autoincrement())
  billNo        String @unique
  orderType     String
  paymentMethod String
  cgst          Float? @default(0)

  sgst Float? @default(0)

  serviceCharge Float? @default(0)

  packingCharge Float?     @default(0)
  // PAYMENT STATUS
  status        BillStatus

  // ORDER STATUS
  orderStatus String @default("COMPLETED")
  subtotal    Float
  gst         Float
  discount    Float
  total       Float

  // Flexible discounts: how `discount` above was derived — a plain manual
  // percentage (the original behavior), a manual flat ₹ amount, or a coupon
  // code. discountApprovedById is set when the discount exceeded the
  // branch's approval threshold and a manager unlocked it (mirrors the
  // manager-only gate refunds/voids already have).
  discountType         String? @default("PERCENTAGE")
  discountCode         String?
  discountApprovedById Int?

  // Cumulative amount refunded so far (see BillRefund) — `total` is reduced
  // by each refund directly so revenue aggregations (which just sum `total`)
  // stay correct without touching every analytics query; this field is only
  // for display ("how much has been refunded off this bill").
  refundedAmount Float? @default(0)

  // Deliberately NOT folded into `total` — a tip isn't restaurant revenue
  // (it's a pass-through to staff), so keeping it separate means every
  // existing revenue/GST query that sums `total` stays correct unchanged.
  // The amount actually collected from the guest is `total + tipAmount`.
  tipAmount Float? @default(0)

  notes String?

  restaurantId Int
  branchId     Int?
  customerId   Int?
  createdById  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id])
  branch     Branch?      @relation(fields: [branchId], references: [id])
  customer   Customer?    @relation(fields: [customerId], references: [id])
  items      BillItem[]
  refunds    BillRefund[]

  @@index([restaurantId])
  @@index([restaurantId, branchId, createdAt])
  @@index([restaurantId, createdAt])
}

// A single partial (or full) refund against an already-paid Bill. Multiple
// rows per bill are allowed (e.g. two separate complaints refunded on
// different days) — this is the audit ledger; Bill.refundedAmount is the
// running total for quick display.
model BillRefund {
  id          Int      @id @default(autoincrement())
  billId      Int
  amount      Float
  reason      String?
  createdById Int?
  createdAt   DateTime @default(now())

  bill Bill @relation(fields: [billId], references: [id])

  @@index([billId])
}

// One row per (branch, financial year) — `lastNumber` is incremented inside
// the same transaction that creates a Bill, so two simultaneous bills can
// never receive the same number and there are never gaps, satisfying GST's
// sequential-invoice-numbering requirement. Indian FY runs Apr 1 – Mar 31;
// `financialYear` stores the FY's starting calendar year (e.g. "2026" for
// FY 2026-27).
model InvoiceSequence {
  id            Int    @id @default(autoincrement())
  restaurantId  Int
  branchId      Int
  financialYear String
  lastNumber    Int    @default(0)

  @@unique([branchId, financialYear])
  @@index([restaurantId])
}

model BillItem {
  id         Int      @id @default(autoincrement())
  billId     Int
  menuItemId Int?
  itemName   String
  quantity   Int
  price      Float
  total      Float
  notes      String? // special instructions, carried over from the KOT item
  createdAt  DateTime @default(now())

  bill   Bill            @relation(fields: [billId], references: [id])
  addOns BillItemAddOn[]

  @@index([billId])
}

// Snapshots the add-on's name/price at order time so a later price change on
// AddOn doesn't rewrite the price on a historical bill.
model BillItemAddOn {
  id         Int      @id @default(autoincrement())
  billItemId Int
  name       String
  price      Float
  createdAt  DateTime @default(now())

  billItem BillItem @relation(fields: [billItemId], references: [id], onDelete: Cascade)

  @@index([billItemId])
}

model RestaurantTable {
  id       Int    @id @default(autoincrement())
  name     String
  capacity Int?
  status   String @default("AVAILABLE")

  isTemporary    Boolean @default(false)
  tempTableType  String?
  parentTableIds String?

  restaurantId  Int
  branchId      Int
  branch        Branch         @relation(fields: [branchId], references: [id])
  runningOrders RunningOrder[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([branchId])
  @@index([restaurantId])
}

model RunningOrder {
  id            Int    @id @default(autoincrement())
  paymentStatus String @default("UNPAID")
  restaurantId  Int
  branchId      Int
  tableId       Int?

  // ORDER INFO
  orderType     String?
  customerName  String?
  customerPhone String?
  paymentMethod String?
  subtotal      Float?  @default(0)

  discountAmount Float? @default(0)

  packingCharge Float? @default(0)

  serviceCharge Float? @default(0)

  gstAmount Float? @default(0)

  cgst Float? @default(0)

  sgst Float? @default(0)

  finalAmount Float? @default(0)

  // Captured at order time for takeaway/online (paid immediately) — carried
  // through to the eventual Bill.tipAmount when this is later closed/billed.
  tipAmount Float? @default(0)

  // Billing lifecycle: "ACTIVE" while the table is ordering, "BILLED" once
  // invoiced upfront but still preparing (quick/takeaway), "CLOSED" once done.
  status String @default("ACTIVE")

  // Set when this order is billed upfront (see closeRunningOrderService's
  // keepOrderActive) — lets the kitchen-complete flow flip the matching
  // Bill's orderStatus from "CONFIRMED" to "COMPLETED" without touching any
  // financial fields. No enforced FK — same loose-coupling pattern as this
  // model's other cross-entity ids (menuItemId, createdById).
  billId Int?

  // KITCHEN STATUS
  kitchenStatus String @default("PENDING")

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdById Int?
  totalAmount Float     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant          @relation(fields: [restaurantId], references: [id])
  branch     Branch              @relation(fields: [branchId], references: [id])
  table      RestaurantTable?    @relation(fields: [tableId], references: [id])
  batches    RunningOrderBatch[]

  @@index([restaurantId])
  @@index([branchId])
  @@index([tableId])
  @@index([restaurantId, branchId, status])
}

model RunningOrderBatch {
  id             Int                     @id @default(autoincrement())
  runningOrderId Int
  createdAt      DateTime                @default(now())
  runningOrder   RunningOrder            @relation(fields: [runningOrderId], references: [id], onDelete: Cascade)
  items          RunningOrderBatchItem[]
}

model RunningOrderBatchItem {
  id                  Int                          @id @default(autoincrement())
  runningOrderBatchId Int
  menuItemId          Int?
  itemName            String
  quantity            Int
  price               Float
  total               Float
  status              String                       @default("PENDING")
  notes               String? // special instructions, e.g. "no onions"
  createdAt           DateTime                     @default(now())
  runningOrderBatch   RunningOrderBatch            @relation(fields: [runningOrderBatchId], references: [id], onDelete: Cascade)
  addOns              RunningOrderBatchItemAddOn[]
}

// Snapshots the add-on's name/price at order time, same reasoning as BillItemAddOn.
model RunningOrderBatchItemAddOn {
  id                      Int      @id @default(autoincrement())
  runningOrderBatchItemId Int
  name                    String
  price                   Float
  createdAt               DateTime @default(now())

  runningOrderBatchItem RunningOrderBatchItem @relation(fields: [runningOrderBatchItemId], references: [id], onDelete: Cascade)

  @@index([runningOrderBatchItemId])
}

model IngredientCategory {
  id           Int          @id @default(autoincrement())
  name         String
  restaurantId Int
  createdAt    DateTime     @default(now())
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id])
  ingredients  Ingredient[]
}

model Ingredient {
  id                   Int                      @id @default(autoincrement())
  name                 String
  restaurantId         Int
  categoryId           Int?
  quantity             Float?
  unit                 String?
  purchasePrice        Float?
  pricePerUnit         Float?
  reorderLevel         Float?
  isAiGenerated        Boolean                  @default(true)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  restaurant           Restaurant               @relation(fields: [restaurantId], references: [id])
  category             IngredientCategory?      @relation(fields: [categoryId], references: [id])
  menuItemIngredients  MenuItemIngredient[]
  ingredientVendors    IngredientVendor[]
  inventoryAdjustments InventoryAdjustment[]
  priceHistory         IngredientPriceHistory[]
  dailyStockAudits     DailyStockAudit[]

  // restaurantId is the filter on nearly every read in ingredient.service.ts
  // (list, reorder-alert scan, vendor-catalog-import name dedup) — all were
  // full-table scans of an unindexed foreign key before this.
  @@index([restaurantId])
  @@index([restaurantId, categoryId])
}

model IngredientVendor {
  id           Int        @id @default(autoincrement())
  branchId     Int
  ingredientId Int
  vendorId     Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  branch       Branch     @relation(fields: [branchId], references: [id])
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  vendor       Vendor     @relation(fields: [vendorId], references: [id])

  @@unique([branchId, ingredientId])
  @@index([branchId])
  @@index([ingredientId])
  @@index([vendorId])
}

model RestaurantInsights {
  id           Int @id @default(autoincrement())
  restaurantId Int
  branchId     Int

  /**
   * FIXED EXPENSES
   */

  monthlyRent Float? @default(0)
  loanEmi     Float? @default(0)
  internet    Float? @default(0)
  phoneBills  Float? @default(0)
  accounting  Float? @default(0)
  insurance   Float? @default(0)
  licenses    Float? @default(0)

  /**
   * RENT MODEL — "FIXED" (default, uses monthlyRent above) or
   * "REVENUE_SHARE" (rent = per-channel % of revenue below). Plain string,
   * not a DB enum — same convention as BudgetItem.category/ShopExpense.expenseType.
   */
  rentModel                String? @default("FIXED")
  rentSharePercentDineIn   Float?  @default(0)
  rentSharePercentTakeaway Float?  @default(0)
  rentSharePercentDelivery Float?  @default(0)

  /**
   * VARIABLE EXPENSES
   */

  deliveryCharges      Float? @default(0)
  packaging            Float? @default(0)
  paymentGateway       Float? @default(0)
  aggregatorCommission Float? @default(0)
  electricity          Float? @default(0)
  gas                  Float? @default(0)
  maintenance          Float? @default(0)
  fuel                 Float? @default(0)
  marketingSpend       Float? @default(0)

  /**
   * FINANCIAL TARGETS
   */

  targetEbitda       Float? @default(0)
  targetFoodCost     Float? @default(0)
  targetGrossMargin  Float? @default(0)
  targetPrimeCost    Float? @default(0)
  monthlyRevenueGoal Float? @default(0)
  monthlyProfitGoal  Float? @default(0)

  /**
   * TAX & FINANCE
   */

  gstPercentage           Float? @default(0)
  monthlyLoanEmi          Float? @default(0)
  monthlyInterestPayments Float? @default(0)
  caFees                  Float? @default(0)
  insuranceCost           Float? @default(0)
  otherTaxes              Float? @default(0)

  /**
   * BUSINESS ASSUMPTIONS
   */

  expectedMonthlyGrowth  Float?  @default(0)
  expectedDeliveryGrowth Float?  @default(0)
  expectedInflation      Float?  @default(0)
  seasonalImpact         Float?  @default(0)
  weekendSalesIncrease   Float?  @default(0)
  plannedExpansion       String?

  /**
   * MANUAL FOOD / RAW MATERIAL COST
   * When set (> 0), overrides the inventory-restock-calculated food cost
   * in the EBITDA calculation so owners who don't track per-ingredient
   * purchases can still get accurate P&L figures.
   */
  manualFoodCost Float? @default(0)

  /**
   * ROI — the owner's one-time initial capital investment in this branch,
   * used to compute ROI = (cumulative net profit - investment) / investment.
   */
  initialInvestment Float? @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  branch     Branch     @relation(fields: [branchId], references: [id])

  @@unique([restaurantId, branchId])
}

/**
 * The single configurable source for every financial target/rate/percentage
 * assumption used by the finance engine (finance.formulas.ts /
 * finance.service.ts) and everything built on top of it — ratio engine,
 * financial statements, budget/scenario/forecast features. Distinct from
 * RestaurantInsights, which holds the actual monthly ₹ expense figures
 * (rent paid, utility bills, etc.) that feed the same engine — this model
 * holds the *rates and targets*, not actuals.
 * Two-tier resolution, done in financeAssumptions.service.ts, NOT in the
 * database: one row per restaurant with branchId = null is the restaurant
 * default; branches may have an additional row (branchId set) whose non-null
 * fields override the default field-by-field. There is intentionally no
 * database-level constraint enforcing "at most one default row per
 * restaurant" (Postgres unique indexes treat multiple NULLs as distinct, and
 * a partial/filtered unique index isn't expressible in schema.prisma without
 * risking the migration-drift issues this project has already hit) — the
 * service layer enforces it via find-then-upsert.
 */
model FinancialAssumptions {
  id           Int  @id @default(autoincrement())
  restaurantId Int
  /**
   * null = restaurant-level default. Set = this branch's override row.
   */
  branchId     Int?

  /**
   * PROPERTY / OCCUPANCY
   */
  rentPerSqFt        Float?
  camPerSqFt         Float?
  chargeableAreaSqFt Float?

  /**
   * TARGETS
   */
  foodCostTargetPercentage  Float?
  labourTargetPercentage    Float?
  primeCostTargetPercentage Float?
  ebitdaTargetPercentage    Float?
  occupancyTargetPercentage Float?
  utilityTargetPercentage   Float?

  /**
   * CHANNEL MIX & COMMISSION
   */
  deliveryPercentage         Float?
  swiggyCommissionPercentage Float?
  zomatoCommissionPercentage Float?

  /**
   * FRANCHISE / ROYALTY
   */
  franchiseFeePercentage Float?
  royaltyPercentage      Float?
  marketingFeePercentage Float?

  /**
   * ESCALATION
   */
  salaryIncrementPercentage Float?
  rentEscalationPercentage  Float?
  inflationPercentage       Float?

  /**
   * TAX & OPERATING CALENDAR
   */
  gstPercentage Float?
  workingDays   Int?
  /**
   * Hours the restaurant operates per day, e.g. 12.5.
   */
  businessHours Float?

  updatedById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  branch     Branch?    @relation(fields: [branchId], references: [id])
  updatedBy  User?      @relation("FinancialAssumptionsUpdatedBy", fields: [updatedById], references: [id])

  @@unique([restaurantId, branchId])
  @@index([restaurantId])
  @@index([branchId])
}

enum BudgetStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/**
 * A budget header — restaurant-wide (branchId = null) or scoped to one
 * branch. Financial Year follows the same convention as InvoiceSequence
 * (the FY's starting calendar year, e.g. "2026" = FY 2026-27, Apr–Mar).
 * "Duplicate" and "copy previous year" are just creating another Budget row
 * with copied BudgetItems — there is deliberately no separate version-history
 * model, since nothing in the spec calls for browsing/diffing past versions.
 */
model Budget {
  id            Int          @id @default(autoincrement())
  restaurantId  Int
  branchId      Int?
  financialYear String
  name          String
  notes         String?
  status        BudgetStatus @default(DRAFT)

  createdById Int?
  updatedById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id])
  branch     Branch?      @relation(fields: [branchId], references: [id])
  createdBy  User?        @relation("BudgetCreatedBy", fields: [createdById], references: [id])
  updatedBy  User?        @relation("BudgetUpdatedBy", fields: [updatedById], references: [id])
  items      BudgetItem[]

  @@index([restaurantId])
  @@index([branchId])
  @@index([restaurantId, financialYear])
}

/**
 * One line item = one budget category for one calendar month. `category` is
 * a plain string (validated against BUDGET_CATEGORIES in budget.types.ts),
 * not a DB enum, so new budgetable categories don't require a migration.
 * `year`/`month` are the actual calendar month (not "FY month 1-12") so they
 * map directly onto the finance engine's period resolution with no
 * translation step.
 */
model BudgetItem {
  id       Int     @id @default(autoincrement())
  budgetId Int
  category String
  year     Int
  month    Int
  amount   Float
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, category, year, month])
  @@index([budgetId])
}

enum ScenarioType {
  CONSERVATIVE
  EXPECTED
  OPTIMISTIC
  CUSTOM
}

/**
 * A named "what-if" planning scenario — restaurant-wide (branchId = null) or
 * scoped to one branch. Every override field mirrors FinancialAssumptions'
 * naming where the concept already exists there (foodCostTargetPercentage,
 * labourTargetPercentage, deliveryPercentage, the commission/fee/escalation
 * percentages, workingDays, businessHours) — a scenario "inherits" from the
 * resolved FinancialAssumptions for fields it doesn't override, exactly like
 * a branch inherits from the restaurant default there. The remaining fields
 * (revenueGrowthPercentage, orderGrowthPercentage, avgOrderValue, rent,
 * utilities, marketing, maintenance, packaging) are new — either genuine
 * what-if deltas with no steady-state equivalent, or absolute ₹ overrides of
 * the actual expense figures the Finance Engine would otherwise use.
 * A scenario is purely a saved set of INPUT overrides. It never stores a
 * calculated/projected value — those are always computed fresh by the
 * What-If Engine at read time and discarded, per the "never persist
 * projected financial values" requirement.
 * No ScenarioVersion model: cloning a scenario is just creating another
 * FinancialScenario row with copied override values, the same pattern
 * Budget's "duplicate" uses — nothing here calls for browsing/diffing a
 * version history.
 */
model FinancialScenario {
  id           Int          @id @default(autoincrement())
  restaurantId Int
  branchId     Int?
  name         String
  description  String?
  type         ScenarioType @default(CUSTOM)
  isActive     Boolean      @default(true)

  /**
   * WHAT-IF DELTAS (no steady-state equivalent in FinancialAssumptions)
   */
  revenueGrowthPercentage Float?
  orderGrowthPercentage   Float?
  avgOrderValue           Float?

  /**
   * ABSOLUTE ₹ OVERRIDES (of the actual expense figures, not a rate/target)
   */
  rent        Float?
  utilities   Float?
  marketing   Float?
  maintenance Float?
  packaging   Float?

  /**
   * RATE/TARGET OVERRIDES — same field names as FinancialAssumptions;
   * inherited from the resolved assumptions when left null here.
   */
  foodCostTargetPercentage   Float?
  labourTargetPercentage     Float?
  deliveryPercentage         Float?
  swiggyCommissionPercentage Float?
  zomatoCommissionPercentage Float?
  royaltyPercentage          Float?
  franchiseFeePercentage     Float?
  salaryIncrementPercentage  Float?
  inflationPercentage        Float?
  rentEscalationPercentage   Float?
  workingDays                Int?
  businessHours              Float?

  createdById Int?
  updatedById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  branch     Branch?    @relation(fields: [branchId], references: [id])
  createdBy  User?      @relation("FinancialScenarioCreatedBy", fields: [createdById], references: [id])
  updatedBy  User?      @relation("FinancialScenarioUpdatedBy", fields: [updatedById], references: [id])

  @@index([restaurantId])
  @@index([branchId])
  @@index([restaurantId, type])
}

enum ForecastPeriodType {
  NEXT_WEEK
  NEXT_MONTH
  NEXT_QUARTER
  NEXT_6_MONTHS
  NEXT_YEAR
}

enum ForecastModelType {
  HISTORICAL_TREND
  MOVING_AVERAGE
  SEASONAL
}

/**
 * A frozen snapshot of a generated forecast — unlike Scenario (which never
 * persists a projected value, by design, since a what-if is infinitely
 * re-runnable), Forecast has an explicit spec requirement (Phase 5 §5,
 * "Forecast vs Actual") to compare a PAST prediction against the actual that
 * later materialized, which is only meaningful if the prediction itself is
 * frozen at the moment it was made — recomputing it later would silently
 * rewrite history and make "accuracy" meaningless. `predictions` is a JSON
 * array of ForecastKpiPrediction (see forecast.types.ts) — a Json column is
 * already an established pattern in this schema (see InventoryRestock.data),
 * used here because the field set is a per-KPI array, not a bounded flat set
 * of independent columns (unlike Scenario/FinancialAssumptions).
 * Snapshots are created idempotently — at most one row per
 * (restaurantId, branchId, periodType, targetStartDate) — the first time
 * that exact future period is forecast for that scope (see
 * ensureForecastSnapshotService), so viewing the dashboard naturally builds
 * up forecast history for later accuracy scoring without a separate manual
 * "save" step.
 */
model FinancialForecast {
  id              Int                @id @default(autoincrement())
  restaurantId    Int
  branchId        Int?
  periodType      ForecastPeriodType
  model           ForecastModelType
  targetStartDate DateTime
  targetEndDate   DateTime
  predictions     Json

  createdById Int?
  createdAt   DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  branch     Branch?    @relation(fields: [branchId], references: [id])
  createdBy  User?      @relation("FinancialForecastCreatedBy", fields: [createdById], references: [id])

  @@index([restaurantId])
  @@index([branchId])
  @@index([restaurantId, periodType])
  @@index([targetEndDate])
}

enum InvestmentType {
  NEW_BRANCH
  BRANCH_EXPANSION
  KITCHEN_UPGRADE
  EQUIPMENT_PURCHASE
  INTERIOR_RENOVATION
  DELIVERY_EXPANSION
  MARKETING_INVESTMENT
  FRANCHISE_OUTLET
  CUSTOM
}

enum InvestmentStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/**
 * A capital investment being evaluated (a new branch, an equipment purchase,
 * a renovation, etc.) — one flat row per project, matching FinancialScenario/
 * FinancialAssumptions' own precedent (a bounded, non-repeating field set
 * doesn't need a child table). Deliberately NO separate InvestmentCashFlow or
 * InvestmentAssumption table: the year-by-year cash flow stream ROI/NPV/IRR
 * need is computed on demand from these assumption fields (plus optional
 * Forecast/Scenario Engine integration) by investment.formulas.ts/
 * investment.service.ts, exactly like Scenario's What-If Engine computes
 * projections on demand rather than persisting them — never stored, so it's
 * always in sync with the latest assumptions. And deliberately NO separate
 * InvestmentScenario table: "evaluate under Conservative/Expected/Optimistic/
 * Custom" reuses the EXISTING FinancialScenario rows for the investment's
 * branch (via an optional scenarioId passed into the metrics calculation),
 * rather than re-implementing scenario types a second time.
 */
model InvestmentProject {
  id           Int              @id @default(autoincrement())
  restaurantId Int
  branchId     Int?
  name         String
  type         InvestmentType   @default(CUSTOM)
  description  String?
  status       InvestmentStatus @default(PLANNED)

  initialInvestment      Float
  plannedStartDate       DateTime
  expectedCompletionDate DateTime?
  projectLifeYears       Int       @default(5)

  /**
   * ASSUMPTIONS — defaults sourced from the Financial Assumptions Engine at
   * creation time where an equivalent field exists (inflationRate <-
   * FinancialAssumptions.inflationPercentage), otherwise a documented
   * finance-standard fallback (discountRate defaults to 12% — this app has
   * no existing "hurdle rate"/WACC concept anywhere to inherit from), always
   * editable afterward and never re-synced.
   */
  discountRate                Float?
  inflationRate               Float?
  monthlyRevenueIncrease      Float?
  revenueGrowthPercentage     Float?
  expectedCostSavings         Float?
  labourSavings               Float?
  additionalOperatingExpenses Float?
  maintenanceCost             Float?
  salvageValue                Float?

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  branch     Branch?    @relation(fields: [branchId], references: [id])
  createdBy  User?      @relation("InvestmentProjectCreatedBy", fields: [createdById], references: [id])

  @@index([restaurantId])
  @@index([branchId])
  @@index([restaurantId, status])
}

/**
 * A restaurant owner's customized target for one Executive KPI scorecard
 * metric — the same two-tier restaurant-default/branch-override pattern as
 * FinancialAssumptions/FinancialScenario. Deliberately NOT a duplicate of
 * FinancialAssumptions' own target fields (foodCostTargetPercentage, etc.):
 * this table is the customization LAYER over the whole scorecard KPI set,
 * including KPIs with no native target field anywhere else in the app
 * (Customer Growth, Repeat Customer %, Branch Count, Active Employees,
 * Inventory Value). When resolving a KPI's target, an explicit row here
 * always wins; otherwise the KPI's native source (FinancialAssumptions/
 * RestaurantInsights) is used, exactly like a scenario override falls back
 * to the resolved assumption when unset — see executive.service.ts's
 * resolveKpiTargetService.
 */
model ExecutiveKpiTarget {
  id           Int    @id @default(autoincrement())
  restaurantId Int
  branchId     Int?
  kpiKey       String
  targetValue  Float

  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  branch     Branch?    @relation(fields: [branchId], references: [id])
  updatedBy  User?      @relation("ExecutiveKpiTargetUpdatedBy", fields: [updatedById], references: [id])

  @@unique([restaurantId, branchId, kpiKey])
  @@index([restaurantId])
}

/**
 * One row per user — their personal Executive Dashboard layout (widget
 * order/visibility), pinned KPIs, and default filters. Nothing here is
 * financial data; a Json layout column matches the same established pattern
 * as FinancialForecast.predictions/InventoryRestock.data (a per-KPI/per-
 * widget array, not a bounded flat field set).
 */
model UserDashboardPreference {
  id           Int @id @default(autoincrement())
  userId       Int @unique
  restaurantId Int

  layout          Json?
  pinnedKpis      Json?
  defaultPeriod   String?
  defaultBranchId Int?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId])
}

/**
 * A lightweight audit log of AI-generated insights — NOT a financial data
 * store. No number here is a new fact; `supportingMetrics`/`recommendedActions`
 * are a frozen copy of what an existing engine (Finance/Budget/Forecast/
 * Scenario/Investment/Executive) already computed at generation time, kept
 * only so the "Historical Insight Timeline" (spec section 10) can show what
 * was flagged over time. Logged idempotently — at most one row per
 * (restaurantId, branchId, category, title, calendar day) — so repeatedly
 * viewing the AI Advisor dashboard in the same business day doesn't spam
 * duplicate rows; this mirrors FinancialForecast's own "idempotent snapshot
 * on generate" precedent (Phase 5), adapted to a daily cadence instead of a
 * forecast-target-period cadence.
 */
model AIInsightLog {
  id           Int  @id @default(autoincrement())
  restaurantId Int
  branchId     Int?

  category   String // "insight" | "anomaly" | "recommendation" | "risk" | "opportunity"
  severity   String // "low" | "medium" | "high" | "critical" | "info"
  title      String
  summary    String
  confidence String // "high" | "medium" | "low"

  supportingMetrics  Json
  recommendedActions Json
  relatedScreens     Json

  logDate     DateTime // calendar day this insight was generated for, floored to midnight — the idempotency key alongside restaurantId/branchId/category/title
  generatedAt DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  branch     Branch?    @relation(fields: [branchId], references: [id])

  @@index([restaurantId])
  @@index([restaurantId, logDate])
  @@index([restaurantId, branchId, category, title, logDate])
}

model InventoryRestock {
  id           Int  @id @default(autoincrement())
  restaurantId Int
  branchId     Int
  month        Int
  year         Int
  data         Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  branch     Branch     @relation(fields: [branchId], references: [id])

  @@unique([restaurantId, branchId, month, year])
  @@index([restaurantId])
  @@index([branchId])
}

model MenuItemIngredient {
  id           Int    @id @default(autoincrement())
  menuItemId   Int
  ingredientId Int
  quantity     Float
  unit         String
  wastage      Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  // menuItemId is looked up inside a held DB transaction on every bill
  // creation and every running-order close (auto stock-deduction) — the
  // hottest checkout-path query in the app. Postgres does not auto-index
  // foreign keys, so this table scanned in full on every checkout before
  // this index existed.
  @@index([menuItemId])
  @@index([ingredientId])
}

model Vendor {
  id                Int                @id @default(autoincrement())
  ingredientVendors IngredientVendor[]
  name              String
  address           String?
  phone             String?
  email             String?
  // Free-text categorization (e.g. "Produce", "Dairy", "Packaging") for
  // Vendor Intelligence filtering — deliberately not an enum since vendor
  // types vary too much by restaurant to standardize server-side.
  vendorType        String?
  restaurantId      Int
  branchId          Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id])
  branch     Branch?         @relation(fields: [branchId], references: [id])
  payments   VendorPayment[]
  invoices   VendorInvoice[]

  @@index([restaurantId])
  @@index([branchId])
}

model VendorPayment {
  id            Int      @id @default(autoincrement())
  vendorId      Int
  restaurantId  Int
  branchId      Int
  amount        Float
  paymentMethod String?
  notes         String?
  paymentDate   DateTime
  createdById   Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vendor     Vendor     @relation(fields: [vendorId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  branch     Branch     @relation(fields: [branchId], references: [id])

  @@index([vendorId])
  @@index([restaurantId])
  @@index([branchId])
}

model VendorInvoice {
  id            Int       @id @default(autoincrement())
  vendorId      Int
  restaurantId  Int
  branchId      Int
  invoiceNumber String?
  invoiceDate   DateTime
  dueDate       DateTime?
  totalAmount   Float
  paidAmount    Float     @default(0)
  status        String    @default("UNPAID")
  items         Json?
  notes         String?
  // Scanned/uploaded e-bill for this invoice — Vendor Intelligence's e-bill
  // tracking. Stored the same way as everything else in /uploads (see
  // middleware/upload.ts), not a duplicate storage mechanism.
  documentUrl   String?
  createdById   Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  vendor     Vendor     @relation(fields: [vendorId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  branch     Branch     @relation(fields: [branchId], references: [id])

  @@index([vendorId])
  @@index([restaurantId])
  @@index([branchId])
}

// ── Foundation: EMI schedules, Equipment, Compliance, Dues ───────────────────
// Shared across Cash Flow Predictor, Dues Tracker, and Equipment Data List —
// built once here rather than per-feature (see plan's cross-cutting notes).

model EmiSchedule {
  id              Int      @id @default(autoincrement())
  restaurantId    Int
  branchId        Int?
  name            String
  principalAmount Float
  emiAmount       Float
  dueDayOfMonth   Int
  startDate       DateTime
  tenureMonths    Int
  notes           String?
  isActive        Boolean  @default(true)
  createdById     Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id])
  branch     Branch?     @relation(fields: [branchId], references: [id])
  equipment  Equipment[]

  @@index([restaurantId])
  @@index([branchId])
}

model Equipment {
  id                     Int       @id @default(autoincrement())
  restaurantId           Int
  branchId               Int
  name                   String
  category               String?
  capacity               String?
  volume                 String?
  itemCapacityCount      Int?

  // Sustained throughput of this unit, in items per hour — the rate that
  // actually constrains a kitchen. Distinct from itemCapacityCount above,
  // which is a BATCH size ("6 pizzas fit in the oven at once") and says
  // nothing about how long a batch takes. A station's ceiling is the sum of
  // its active units' itemsPerHour.
  itemsPerHour           Int?

  // Which kitchen station this unit belongs to, so equipment throughput can
  // be rolled up per station for bottleneck attribution. Optional — plenty of
  // equipment (billing printer, deep freezer) belongs to no cooking station.
  stationId              Int?
  powerConsumptionKw     Float?
  purchasePrice          Float?
  purchaseDate           DateTime?
  emiScheduleId          Int?
  installationDate       DateTime?
  warrantyExpiryDate     DateTime?
  expectedLifespanMonths Int?
  serviceProviderName    String?
  serviceProviderContact String?
  nextMaintenanceDate    DateTime?
  maintenanceNotes       String?
  isActive               Boolean   @default(true)
  createdById            Int?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  restaurant  Restaurant      @relation(fields: [restaurantId], references: [id])
  branch      Branch          @relation(fields: [branchId], references: [id])
  emiSchedule EmiSchedule?    @relation(fields: [emiScheduleId], references: [id])
  station     KitchenStation? @relation(fields: [stationId], references: [id])

  @@index([restaurantId])
  @@index([branchId])
  @@index([emiScheduleId])
  @@index([stationId])
}

model ComplianceRecord {
  id              Int       @id @default(autoincrement())
  restaurantId    Int
  branchId        Int
  // FSSAI | FIRE_SAFETY | PEST_CONTROL | GST_FILING
  type            String
  licenseNumber   String?
  issueDate       DateTime?
  expiryDate      DateTime?
  // For GST_FILING this is the computed next filing due date (GSTR-3B,
  // 20th of the following month) rather than a manually-entered value —
  // Cash Flow Predictor and Dues Tracker read this field, they don't
  // recompute the due-date rule themselves.
  nextDueDate     DateTime?
  status          String    @default("VALID") // VALID | EXPIRING_SOON | EXPIRED | DUE
  documentUrl     String?
  lastRenewedDate DateTime?
  notes           String?
  createdById     Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  branch     Branch     @relation(fields: [branchId], references: [id])

  @@index([restaurantId])
  @@index([branchId])
  @@index([type])
}

model MonthlyDue {
  id           Int       @id @default(autoincrement())
  restaurantId Int
  branchId     Int
  // EB | SALARIES | RENT | OPERATIONS | UTILITIES | MAINTENANCE | MISC | EMI
  category     String
  month        Int
  year         Int
  amountDue    Float
  amountPaid   Float     @default(0)
  dueDate      DateTime?
  paidDate     DateTime?
  status       String    @default("PENDING") // PENDING | PARTIAL | PAID | OVERDUE
  notes        String?
  createdById  Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  branch     Branch     @relation(fields: [branchId], references: [id])

  @@index([restaurantId])
  @@index([branchId])
  @@index([month, year])
}

// ── WhatsApp Integration ──────────────────────────────────────────────────────
// One message log + sender interface shared by Vendor Intelligence (reorder),
// Compliance Checker (GST reminders), and general customer messaging.

model WhatsAppMessageLog {
  id                Int      @id @default(autoincrement())
  restaurantId      Int
  branchId          Int?
  direction         String   @default("OUTBOUND")
  recipientPhone    String
  // CUSTOMER_MARKETING | VENDOR_EBILL | VENDOR_PAYMENT | GST_UPDATE
  templateType      String
  message           String
  payload           Json?
  // QUEUED | SENT | FAILED — always SENT today since only a mock sender
  // exists (see config/whatsapp.ts); kept as a real status column so a live
  // provider can be swapped in later without a schema change.
  status            String   @default("SENT")
  relatedEntityType String?
  relatedEntityId   Int?
  createdById       Int?
  createdAt         DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  branch     Branch?    @relation(fields: [branchId], references: [id])

  @@index([restaurantId])
  @@index([branchId])
}

/**
 * A reusable bulk-marketing message body — capped at 5 per restaurant
 * (enforced in whatsapp.service.ts, not here; every other "at most N"
 * constraint in this schema is a service-layer check, not a DB one — see
 * cash.service.ts's single-open-session guard for the same pattern).
 * `message` may contain a `{{name}}` placeholder, substituted per-recipient
 * with their real name when a bulk send goes out.
 */
model WhatsAppTemplate {
  id           Int      @id @default(autoincrement())
  restaurantId Int
  name         String
  message      String
  createdById  Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  createdBy  User?      @relation("WhatsAppTemplateCreatedBy", fields: [createdById], references: [id])

  @@index([restaurantId])
}

// ── Payroll extensions (Cash Flow Predictor sub-features) ────────────────────

model LeaveRequest {
  id           Int      @id @default(autoincrement())
  userId       Int
  restaurantId Int
  branchId     Int
  leaveType    String   @default("CASUAL") // CASUAL | SICK | EARNED | UNPAID
  startDate    DateTime
  endDate      DateTime
  reason       String?
  status       String   @default("PENDING") // PENDING | APPROVED | REJECTED
  approvedById Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  branch     Branch     @relation(fields: [branchId], references: [id])

  @@index([userId])
  @@index([restaurantId])
  @@index([branchId])
}

model SalaryDeduction {
  id            Int      @id @default(autoincrement())
  userId        Int
  restaurantId  Int
  branchId      Int
  deductionType String   @default("OTHER") // ADVANCE | FINE | UNPAID_LEAVE | OTHER
  amount        Float
  month         Int
  year          Int
  notes         String?
  createdById   Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  branch     Branch     @relation(fields: [branchId], references: [id])

  @@index([userId])
  @@index([restaurantId])
  @@index([branchId])
  @@index([month, year])
}

model PayrollRun {
  id            Int      @id @default(autoincrement())
  restaurantId  Int
  branchId      Int
  month         Int
  year          Int
  status        String   @default("PROCESSED") // DRAFT | PROCESSED
  totalPayout   Float    @default(0)
  generatedById Int?
  createdAt     DateTime @default(now())

  restaurant Restaurant       @relation(fields: [restaurantId], references: [id])
  branch     Branch           @relation(fields: [branchId], references: [id])
  lines      PayrollRunLine[]

  @@unique([branchId, month, year])
  @@index([restaurantId])
  @@index([branchId])
}

model PayrollRunLine {
  id           Int   @id @default(autoincrement())
  payrollRunId Int
  userId       Int
  baseSalary   Float
  overtimePay  Float @default(0)
  deductions   Float @default(0)
  netPay       Float

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@index([payrollRunId])
  @@index([userId])
}

// ── Account & Bank Integration ────────────────────────────────────────────────
// No payment gateway is integrated (no Razorpay/Cashfree/etc. account exists)
// — these models track the restaurant's own bank/UPI details and manually
// entered/reconciled transactions, not a live gateway sync.

model BankAccount {
  id                  Int      @id @default(autoincrement())
  restaurantId        Int
  branchId            Int?
  accountHolderName   String
  bankName            String
  accountNumberMasked String
  ifsc                String
  isPrimary           Boolean  @default(false)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  branch     Branch?    @relation(fields: [branchId], references: [id])

  @@index([restaurantId])
  @@index([branchId])
}

model UpiConfig {
  id           Int      @id @default(autoincrement())
  restaurantId Int
  branchId     Int
  upiId        String
  displayName  String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  branch     Branch     @relation(fields: [branchId], references: [id])

  @@unique([branchId])
  @@index([restaurantId])
}

model BankTransactionEntry {
  id                     Int      @id @default(autoincrement())
  restaurantId           Int
  branchId               Int
  bankAccountId          Int?
  entryDate              DateTime
  description            String?
  amount                 Float
  type                   String // CREDIT | DEBIT
  // Best-effort match against a Bill or VendorPayment by amount + date
  // proximity — set by the reconciliation endpoint, editable by the owner.
  // This is manual/assisted reconciliation, not a live gateway webhook.
  reconciliationStatus   String   @default("UNMATCHED") // UNMATCHED | MATCHED | IGNORED
  matchedBillId          Int?
  matchedVendorPaymentId Int?
  notes                  String?
  createdById            Int?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  branch     Branch     @relation(fields: [branchId], references: [id])

  @@index([restaurantId])
  @@index([branchId])
}

model IngredientPriceHistory {
  id           Int      @id @default(autoincrement())
  ingredientId Int
  restaurantId Int
  oldPrice     Float?
  newPrice     Float
  changedById  Int?
  createdAt    DateTime @default(now())

  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([ingredientId])
  @@index([restaurantId])
}

model Attendance {
  id Int @id @default(autoincrement())

  userId       Int
  restaurantId Int
  branchId     Int

  date DateTime

  loginTime  DateTime?
  logoutTime DateTime?

  totalHours Float? @default(0)

  // Owner-entered override for this day's hours, and additional overtime
  // hours — both entered manually from owner-web, independent of whatever
  // the POS clock-in/out computed. When set, manualTotalHours is used in
  // place of the auto-computed totalHours for payroll/display purposes.
  manualTotalHours Float?
  overtimeHours    Float? @default(0)

  status String? // PRESENT, ABSENT, HALF_DAY

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  branch     Branch     @relation(fields: [branchId], references: [id])

  breaks AttendanceBreak[]

  @@unique([userId, date])
  @@index([userId])
  @@index([branchId])
  @@index([date])
}

model AttendanceBreak {
  id Int @id @default(autoincrement())

  attendanceId Int

  startTime DateTime
  endTime   DateTime?

  totalMinutes Int? @default(0)

  reason String?

  createdAt DateTime @default(now())

  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([attendanceId])
}

model DailyCashSession {
  id Int @id @default(autoincrement())

  restaurantId Int
  branchId     Int

  openedById Int
  closedById Int?

  businessDate DateTime

  openingCash Float @default(0)

  expectedCash Float @default(0)

  actualCash Float @default(0)

  closingCash Float @default(0)

  cashDifference Float @default(0)

  notes String?

  openedAt DateTime  @default(now())
  closedAt DateTime?

  status String @default("OPEN")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  branch     Branch     @relation(fields: [branchId], references: [id])

  // No longer unique per (branch, day) — a branch can have several
  // concurrent tills/cashiers, each with their own session on the same
  // business date. Uniqueness (one open session per cashier at a time) is
  // enforced in application code instead, since a DB constraint can't say
  // "unique while status = OPEN" without a partial index this schema
  // doesn't otherwise use.
  @@index([restaurantId])
  @@index([branchId])
  @@index([openedById])
  // Matches Bill's own restaurantId+date composite index — cash.service.ts
  // filters/orders by businessDate the same way reports/analytics filter
  // Bill by createdAt.
  @@index([branchId, businessDate])
}

model ShopExpense {
  id Int @id @default(autoincrement())

  restaurantId Int
  branchId     Int

  title       String
  description String?

  amount Float

  expenseType String?

  paymentSource String

  paidByUserId Int?

  expenseDate DateTime

  createdById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  branch     Branch     @relation(fields: [branchId], references: [id])

  paidByUser User? @relation("ExpensePaidByUser", fields: [paidByUserId], references: [id])

  @@index([restaurantId])
  @@index([branchId])
  @@index([paidByUserId])
  // Matches Bill's own restaurantId+date composite index — reports.service.ts
  // and branchComparison.service.ts filter this table by expenseDate the
  // same way Bill is filtered by createdAt, but had no matching index.
  @@index([restaurantId, expenseDate])
}

model InventoryAdjustment {
  id Int @id @default(autoincrement())

  restaurantId Int
  branchId     Int

  ingredientId Int

  quantity Float

  adjustmentType String
  // DAMAGE
  // WASTAGE
  // EXPIRED
  // MANUAL

  reason String?

  updatedById Int?

  createdAt DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  branch     Branch     @relation(fields: [branchId], references: [id])

  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  updatedBy  User?      @relation("InventoryUpdatedBy", fields: [updatedById], references: [id])

  @@index([restaurantId])
  @@index([branchId])
}

model DailyStockAudit {
  id           Int      @id @default(autoincrement())
  restaurantId Int
  branchId     Int
  ingredientId Int
  auditDate    DateTime // date of the audit (store as midnight UTC for the day)
  openingQty   Float // stock at start of day (auto-filled from prev closing or current ingredient qty)
  sopConsumed  Float // calculated from orders: Σ(billItem.qty × recipe.qty) for that day
  closingQty   Float // actual stock entered by staff at end of day
  wastage      Float // (openingQty - sopConsumed) - closingQty
  notes        String? // optional staff notes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  branch     Branch     @relation(fields: [branchId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([branchId, ingredientId, auditDate])
  @@index([branchId])
  @@index([restaurantId])
  @@index([branchId, auditDate])
}

model SopChecklist {
  id           Int      @id @default(autoincrement())
  restaurantId Int
  branchId     Int?
  menuItemId   Int?
  title        String
  category     String? // e.g. "Prep", "Hygiene", "Portioning"
  steps        Json // ordered array of step strings
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  branch     Branch?    @relation(fields: [branchId], references: [id])
  menuItem   MenuItem?  @relation(fields: [menuItemId], references: [id])

  @@index([restaurantId])
  @@index([branchId])
  @@index([menuItemId])
}

enum ProcurementAvailability {
  IN_STOCK
  LIMITED_STOCK
  OUT_OF_STOCK
  UNKNOWN
}

// External supplier platforms compared by Procurement Intelligence
// (Hyperpure, Zepto Business, Instamart, ...). Distinct from Vendor, which
// tracks a restaurant's own real-world suppliers for payments/invoices.
model Supplier {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  displayName String
  isActive    Boolean  @default(true)
  iconUrl     String?
  createdAt   DateTime @default(now())

  snapshots ProcurementPriceSnapshot[]
}

// A single price observation for a search term on one supplier at a point in
// time. Cached/keyed by (supplierId, searchTerm, city) rather than per
// restaurant, since the same supplier's public catalog price is shared across
// every restaurant in the same city — capturedByRestaurantId is attribution
// only, not a scoping key.
model ProcurementPriceSnapshot {
  id                     Int                     @id @default(autoincrement())
  supplierId             Int
  searchTerm             String
  city                   String?
  productName            String
  price                  Float
  unit                   String
  availability           ProcurementAvailability @default(UNKNOWN)
  currency               String                  @default("INR")
  sourceUrl              String?
  capturedByRestaurantId Int?
  capturedAt             DateTime                @default(now())
  createdAt              DateTime                @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId, searchTerm, city])
  @@index([searchTerm, capturedAt])
}

// ─── Labor & Kitchen Capacity Engine ─────────────────────────────────────────
//
// Before these tables, kitchen load was modelled as a flat order count divided
// by one global constant (peakHour.formulas.ts's DEFAULT_ORDERS_PER_STAFF_HOUR
// = 8 orders/staff/hour). That model cannot answer the question an owner
// actually has — "am I short of PEOPLE or short of EQUIPMENT?" — because it has
// no concept of where in the kitchen the work happens. A single number also
// hides that 40 burgers and 40 biryanis are wildly different workloads.
//
// These three tables add the missing dimension (station), and with it:
//   station workload minutes = Σ (forecast qty × per-station minutes per item)
//   required staff           = workload minutes ÷ (window × utilizationFactor)
//   equipment-bound?         = demand items/hour vs station capacityPerHour
// See modules/labor/labor.formulas.ts for the arithmetic, which is pure and
// unit-tested, and modules/labor/labor.engine.service.ts for the pipeline.

model KitchenStation {
  id           Int    @id @default(autoincrement())
  restaurantId Int
  branchId     Int
  name         String

  // Stable uppercase key (GRILL, FRYER, PREP, PLATING, TANDOOR…), unique per
  // branch. Labor standards and seeded defaults are matched on code rather
  // than display name so renaming "Grill" to "Grill / Griddle" doesn't orphan
  // every menu item's standard time.
  code String

  // Fraction of a clock hour a person at this station is actually producing
  // food. Per-station because a plating pass is far more continuously occupied
  // than a prep bench. Null = inherit the branch's staffUtilizationFactor.
  utilizationFactor Float?

  // Physical items/hour ceiling of the station itself, independent of
  // headcount — one pizza oven does not go faster because two people stand at
  // it. Null = fall back to summing linked Equipment.itemsPerHour; if that is
  // also empty, NO equipment assessment is made rather than guessing a
  // threshold (same "no assessment possible" stance as
  // peakHour.formulas.ts's computeBottleneckStatus).
  capacityPerHour Int?

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  restaurant    Restaurant            @relation(fields: [restaurantId], references: [id])
  branch        Branch                @relation(fields: [branchId], references: [id])
  equipment     Equipment[]
  menuItemTimes MenuItemStationTime[]
  staffSkills   StaffStationSkill[]

  @@unique([branchId, code])
  @@index([restaurantId])
  @@index([branchId])
}

// Per-item labor standard AT ONE STATION — the "don't only store total
// preparation time, store station-specific task time" requirement. MenuItem
// already carries a single prepTime (whole-item minutes, used for customer-
// facing ETA display); that field is left untouched and is NOT the same thing:
// a burger's 8 total minutes might be 4 grill + 2 fryer + 1 prep + 1 plating,
// and only the split tells you which station saturates first.
model MenuItemStationTime {
  id         Int @id @default(autoincrement())
  menuItemId Int
  stationId  Int

  // Owner-entered expected labor minutes for ONE unit of this item at this
  // station.
  standardMinutes Float

  // Calibrated-from-actuals minutes, written by the labor learning pass
  // (labor.learning.service.ts) once enough completed orders have been
  // observed. Null until then. Kept SEPARATE from standardMinutes so the
  // owner's entered standard is never silently overwritten and the two can be
  // shown side by side.
  observedMinutes  Float?
  observationCount Int    @default(0)
  lastObservedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menuItem MenuItem       @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  station  KitchenStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, stationId])
  @@index([menuItemId])
  @@index([stationId])
}

// Who can work which station, and how fast. Turns "how many people do I need?"
// into "who should stand where?" — a 4.5-FTE grill requirement plus a 1.8-FTE
// plating requirement does not necessarily mean 7 bodies if some of them can
// cover both.
model StaffStationSkill {
  id        Int @id @default(autoincrement())
  userId    Int
  stationId Int

  // 1–5. 0 is not used — absence of a row already means "cannot work here",
  // so a stored 0 would be an ambiguous second way to say the same thing.
  proficiency Int @default(3)

  // Throughput multiplier vs. the standard time: 1.1 = 10% faster than the
  // standard, 0.9 = 10% slower. Owner-entered. NOT auto-learned per employee:
  // RunningOrder carries no per-employee attribution (nothing records which
  // cook made which item), so a genuine per-person speed cannot be derived
  // from this schema — see labor.learning.service.ts, which calibrates ITEM
  // times (which the data does support) and reports per-employee shift
  // throughput as explicitly correlational context only.
  speedFactor Float @default(1.0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  station KitchenStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([userId, stationId])
  @@index([userId])
  @@index([stationId])
}
