enum ProcurementAvailability {
  IN_STOCK
  LIMITED_STOCK
  OUT_OF_STOCK
  UNKNOWN
}

// External supplier platforms compared by Procurement Intelligence
// (Hyperpure, Zepto Business, Instamart, ...). Distinct from Vendor, which
// tracks a restaurant's own real-world suppliers for payments/invoices.
model Supplier {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  displayName String
  isActive    Boolean  @default(true)
  iconUrl     String?
  createdAt   DateTime @default(now())

  snapshots ProcurementPriceSnapshot[]
}

// A single price observation for a search term on one supplier at a point in
// time. Cached/keyed by (supplierId, searchTerm, city) rather than per
// restaurant, since the same supplier's public catalog price is shared across
// every restaurant in the same city — capturedByRestaurantId is attribution
// only, not a scoping key.
model ProcurementPriceSnapshot {
  id                     Int                     @id @default(autoincrement())
  supplierId             Int
  searchTerm             String
  city                   String?
  productName            String
  price                  Float
  unit                   String
  availability           ProcurementAvailability @default(UNKNOWN)
  currency               String                  @default("INR")
  sourceUrl              String?
  capturedByRestaurantId Int?
  capturedAt             DateTime                @default(now())
  createdAt              DateTime                @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId, searchTerm, city])
  @@index([searchTerm, capturedAt])
}

// ─── Labor & Kitchen Capacity Engine ─────────────────────────────────────────
//
// Before these tables, kitchen load was modelled as a flat order count divided
// by one global constant (peakHour.formulas.ts's DEFAULT_ORDERS_PER_STAFF_HOUR
// = 8 orders/staff/hour). That model cannot answer the question an owner
// actually has — "am I short of PEOPLE or short of EQUIPMENT?" — because it has
// no concept of where in the kitchen the work happens. A single number also
// hides that 40 burgers and 40 biryanis are wildly different workloads.
//
// These three tables add the missing dimension (station), and with it:
//   station workload minutes = Σ (forecast qty × per-station minutes per item)
//   required staff           = workload minutes ÷ (window × utilizationFactor)
//   equipment-bound?         = demand items/hour vs station capacityPerHour
// See modules/labor/labor.formulas.ts for the arithmetic, which is pure and
// unit-tested, and modules/labor/labor.engine.service.ts for the pipeline.

model KitchenStation {
  id           Int    @id @default(autoincrement())
  restaurantId Int
  branchId     Int
  name         String

  // Stable uppercase key (GRILL, FRYER, PREP, PLATING, TANDOOR…), unique per
  // branch. Labor standards and seeded defaults are matched on code rather
  // than display name so renaming "Grill" to "Grill / Griddle" doesn't orphan
  // every menu item's standard time.
  code String

  // Fraction of a clock hour a person at this station is actually producing
  // food. Per-station because a plating pass is far more continuously occupied
  // than a prep bench. Null = inherit the branch's staffUtilizationFactor.
  utilizationFactor Float?

  // Physical items/hour ceiling of the station itself, independent of
  // headcount — one pizza oven does not go faster because two people stand at
  // it. Null = fall back to summing linked Equipment.itemsPerHour; if that is
  // also empty, NO equipment assessment is made rather than guessing a
  // threshold (same "no assessment possible" stance as
  // peakHour.formulas.ts's computeBottleneckStatus).
  capacityPerHour Int?

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  restaurant    Restaurant            @relation(fields: [restaurantId], references: [id])
  branch        Branch                @relation(fields: [branchId], references: [id])
  equipment     Equipment[]
  menuItemTimes MenuItemStationTime[]
  staffSkills   StaffStationSkill[]

  @@unique([branchId, code])
  @@index([restaurantId])
  @@index([branchId])
}

// Per-item labor standard AT ONE STATION — the "don't only store total
// preparation time, store station-specific task time" requirement. MenuItem
// already carries a single prepTime (whole-item minutes, used for customer-
// facing ETA display); that field is left untouched and is NOT the same thing:
// a burger's 8 total minutes might be 4 grill + 2 fryer + 1 prep + 1 plating,
// and only the split tells you which station saturates first.
model MenuItemStationTime {
  id         Int @id @default(autoincrement())
  menuItemId Int
  stationId  Int

  // Owner-entered expected labor minutes for ONE unit of this item at this
  // station.
  standardMinutes Float

  // Calibrated-from-actuals minutes, written by the labor learning pass
  // (labor.learning.service.ts) once enough completed orders have been
  // observed. Null until then. Kept SEPARATE from standardMinutes so the
  // owner's entered standard is never silently overwritten and the two can be
  // shown side by side.
  observedMinutes  Float?
  observationCount Int    @default(0)
  lastObservedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menuItem MenuItem       @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  station  KitchenStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, stationId])
  @@index([menuItemId])
  @@index([stationId])
}

// Who can work which station, and how fast. Turns "how many people do I need?"
// into "who should stand where?" — a 4.5-FTE grill requirement plus a 1.8-FTE
// plating requirement does not necessarily mean 7 bodies if some of them can
// cover both.
model StaffStationSkill {
  id        Int @id @default(autoincrement())
  userId    Int
  stationId Int

  // 1–5. 0 is not used — absence of a row already means "cannot work here",
  // so a stored 0 would be an ambiguous second way to say the same thing.
  proficiency Int @default(3)

  // Throughput multiplier vs. the standard time: 1.1 = 10% faster than the
  // standard, 0.9 = 10% slower. Owner-entered. NOT auto-learned per employee:
  // RunningOrder carries no per-employee attribution (nothing records which
  // cook made which item), so a genuine per-person speed cannot be derived
  // from this schema — see labor.learning.service.ts, which calibrates ITEM
  // times (which the data does support) and reports per-employee shift
  // throughput as explicitly correlational context only.
  speedFactor Float @default(1.0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  station KitchenStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([userId, stationId])
  @@index([userId])
  @@index([stationId])
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
// DINE INC. INTERNAL OPERATIONS PLATFORM
//
// Everything below backs the internal employee application, not the
// restaurant-facing apps. Two rules hold throughout:
//
//   1. Internal employees are a DIFFERENT ACTOR from `User`. `User` is
//      restaurant-scoped (it carries restaurantId/branchId, and loginUser lets
//      any User row into owner-web and the POS). Putting Dine Inc. staff there
//      would hand them a restaurant login and break every tenant guard in
//      middleware/authorize.ts. Hence InternalUser, with its own auth surface.
//
//   2. Nothing here duplicates a business entity. Restaurants, customers,
//      orders/bills and menus stay in the models above and are read through the
//      existing services; the tables below only add what the platform itself
//      owns â€” identity, permissions, audit, support and onboarding state.
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

/// Whether an outlet is trading. Separate from every commercial state: an
/// outlet can be CLOSED while the account is a healthy paying customer.
enum LocationOperationalStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum RestaurantPlatformStatus {
  LEAD
  ONBOARDING
  ACTIVE
  SUSPENDED
  CHURNED
}

enum RestaurantOnboardingStage {
  LEAD
  INTERESTED
  ONBOARDING
  VERIFICATION
  CONFIGURATION
  TESTING
  READY
  ACTIVE
}

enum InternalUserStatus {
  INVITED
  ACTIVE
  DISABLED
}

// â”€â”€â”€ Identity & RBAC â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model InternalUser {
  id           Int                @id @default(autoincrement())
  employeeCode String             @unique // EMP-0001 â€” the id shown in the UI
  name         String
  email        String             @unique // company email; the login identifier
  password     String
  phone        String?
  department   String?
  designation  String?
  status       InternalUserStatus @default(ACTIVE)

  // Privileged roles can be required to enrol in 2FA; the flag is stored per
  // user so the requirement can be tightened for one person without a schema
  // change. The secret is only populated once enrolment completes.
  twoFactorEnabled  Boolean @default(false)
  twoFactorRequired Boolean @default(false)
  twoFactorSecret   String?

  // Login-attempt protection. The backend has no rate limiter of any kind, so
  // lockout state lives here rather than in memory â€” a restart must not reset
  // an attacker's budget, and the API runs more than one instance.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  lastLoginIp      String?

  mustChangePassword Boolean @default(true)

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles               InternalUserRole[]
  sessions            InternalSession[]
  passwordResets      InternalPasswordResetToken[]
  ticketsCreated      SupportTicket[]              @relation("TicketCreatedBy")
  ticketsAssigned     SupportTicket[]              @relation("TicketAssignedTo")
  ticketComments      SupportTicketComment[]
  ticketEvents        SupportTicketEvent[]
  onboardingTasksDone RestaurantOnboardingTask[]

  // ─── Commercial model back-relations ─────────────────────────────────────
  accountsOwned          Account[]           @relation("AccountOwner")
  accountAssignments     AccountAssignment[] @relation("AssignedAccounts")
  subscriptionEvents     SubscriptionEvent[] @relation("SubscriptionEventActor")
  onboardingsAssigned    Onboarding[]        @relation("OnboardingAssignee")
  onboardingTasksAssigned OnboardingTask[]   @relation("OnboardingTaskAssignee")
  onboardingTasksCompleted OnboardingTask[]  @relation("OnboardingTaskCompleter")
  onboardingEvents       OnboardingEvent[]   @relation("OnboardingEventActor")
  opportunitiesOwned     Opportunity[]       @relation("OpportunityOwner")
  accountLifecycleEvents AccountLifecycleEvent[] @relation("AccountLifecycleActor")

  @@index([status])
  @@index([department])
}

// A named bundle of permissions. `key` is the stable identifier code refers to
// (SUPER_ADMIN, OPERATIONS_ADMIN, â€¦); `name` is editable copy. isSystem marks
// the seeded roles â€” they can be granted/revoked permissions by an authorized
// admin but never deleted, so an install can't lock itself out.
/// How much of the customer base a role can reach.
///
/// Permissions say what someone may do; this says to whom. Without it,
/// "Support may read customers" necessarily meant every customer DineInk has.
enum AccountScope {
  ALL_ACCOUNTS
  ASSIGNED_ACCOUNTS
}

model InternalRole {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  name        String
  description String?
  isSystem    Boolean @default(false)

  /// Defaults to the narrower of the two. A new role invented by an
  /// administrator should start unable to see the whole book, not able to.
  accountScope AccountScope @default(ASSIGNED_ACCOUNTS)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions InternalRolePermission[]
  users       InternalUserRole[]
}

// Permission keys are defined in code (modules/internal/rbac/permissions.ts) â€”
// that catalog is the source of truth, so a typo can't silently create a
// permission nothing checks. This table only records which role holds which.
model InternalRolePermission {
  id         Int    @id @default(autoincrement())
  roleId     Int
  permission String

  role InternalRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
  @@index([permission])
}

model InternalUserRole {
  id          Int      @id @default(autoincrement())
  userId      Int
  roleId      Int
  grantedById Int?
  createdAt   DateTime @default(now())

  user InternalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role InternalRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

// One row per issued access token. The restaurant apps use bare stateless JWTs,
// which cannot be revoked before they expire â€” unacceptable for a console that
// can suspend restaurants and approve refunds. Every internal token carries a
// jti matched against this table on each request, so "log out everywhere",
// disabling an employee, or a role change can cut access immediately.
model InternalSession {
  id            Int       @id @default(autoincrement())
  userId        Int
  tokenId       String    @unique
  ip            String?
  userAgent     String?
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?

  user InternalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model InternalPasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user InternalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Deliberately keyed by email rather than user id: attempts against an address
// that doesn't exist must be counted too, otherwise enumeration is free.
model InternalLoginAttempt {
  id        Int      @id @default(autoincrement())
  email     String
  ip        String?
  success   Boolean
  reason    String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([createdAt])
}

// â”€â”€â”€ Audit â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

// Append-only from the application's point of view: the internal API exposes
// create + read and no update/delete path whatsoever. actorEmail is denormalized
// so a log line still names who acted after the employee record is gone, and
// resourceId is a plain string (not an FK) so an audit row outlives the row it
// describes.
model InternalAuditLog {
  id            Int      @id @default(autoincrement())
  actorId       Int?
  actorEmail    String?
  actorName     String?
  action        String // RESTAURANT_SUSPEND, ROLE_PERMISSIONS_UPDATE, â€¦
  resourceType  String // Restaurant, InternalUser, SupportTicket, â€¦
  resourceId    String?
  resourceLabel String?
  previousValue Json?
  newValue      Json?
  reason        String?
  ip            String?
  userAgent     String?
  correlationId String?
  createdAt     DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([resourceType, resourceId])
  @@index([action, createdAt])
  @@index([createdAt])
}

// â”€â”€â”€ Restaurant onboarding â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

enum OnboardingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETE
  BLOCKED
  NOT_APPLICABLE
}

// The checklist a restaurant must clear before it can be activated. Rows are
// materialized per restaurant from a code-defined template so the template can
// gain a step without rewriting history: restaurants already onboarded keep the
// checklist they were actually held to.
model RestaurantOnboardingTask {
  id            Int                  @id @default(autoincrement())
  restaurantId  Int
  key           String
  label         String
  category      String
  isMandatory   Boolean              @default(true)
  status        OnboardingTaskStatus @default(PENDING)
  notes         String?
  sortOrder     Int                  @default(0)
  completedAt   DateTime?
  completedById Int?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  restaurant  Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  completedBy InternalUser? @relation(fields: [completedById], references: [id])

  @@unique([restaurantId, key])
  @@index([restaurantId, status])
}

// â”€â”€â”€ Support tickets â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

enum TicketCategory {
  PAYMENT
  ORDER
  RESTAURANT
  CUSTOMER
  LOGIN
  QR
  MENU
  ACCOUNT
  TECHNICAL
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  NEW
  TRIAGED
  IN_PROGRESS
  WAITING_FOR_INFORMATION
  ESCALATED_TO_ENGINEERING
  ENGINEERING_RESOLVED
  VERIFICATION
  RESOLVED
  CLOSED
}

model SupportTicket {
  id          Int            @id @default(autoincrement())
  ticketNo    String         @unique // DINE-1024
  title       String
  description String
  category    TicketCategory
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(NEW)

  createdById  Int
  assignedToId Int?

  // Linked entities are scalar ids, not foreign keys, on purpose: a ticket is a
  // record of what someone reported and must survive the order, customer or
  // restaurant it referenced being removed. Every read of a linked record goes
  // back through the internal API and is re-checked against the caller's
  // permissions â€” the link itself grants nothing.
  accountId      Int?
  restaurantId   Int?
  customerId     Int?
  billId         Int?
  runningOrderId Int?
  /// Which product the complaint concerns. Scalar for the same reason as the
  /// ids above — the ticket is a record of what was reported.
  productId      Int?

  // Technical context captured at escalation time and forwarded to Jira.
  errorCode     String?
  correlationId String?
  environment   String?

  jiraIssueKey String?
  jiraIssueUrl String?
  jiraStatus   String?
  jiraSyncedAt DateTime?

  escalatedAt DateTime?
  resolvedAt  DateTime?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy   InternalUser              @relation("TicketCreatedBy", fields: [createdById], references: [id])
  assignedTo  InternalUser?             @relation("TicketAssignedTo", fields: [assignedToId], references: [id])
  comments    SupportTicketComment[]
  events      SupportTicketEvent[]
  attachments SupportTicketAttachment[]

  @@index([status, priority])
  @@index([accountId])
  @@index([restaurantId])
  @@index([assignedToId])
  @@index([createdAt])
}

model SupportTicketComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  body      String
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author InternalUser  @relation(fields: [authorId], references: [id])

  @@index([ticketId])
}

// The ticket's timeline â€” status changes, assignment, escalation, Jira sync.
// Separate from comments so the narrative and the state history don't have to
// be untangled from one another when rendering the detail page.
model SupportTicketEvent {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  actorId   Int?
  type      String // STATUS_CHANGED, ASSIGNED, ESCALATED, JIRA_LINKED, â€¦
  fromValue String?
  toValue   String?
  message   String?
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  InternalUser? @relation(fields: [actorId], references: [id])

  @@index([ticketId, createdAt])
}

model SupportTicketAttachment {
  id           Int      @id @default(autoincrement())
  ticketId     Int
  fileName     String
  filePath     String
  mimeType     String?
  size         Int?
  uploadedById Int?
  createdAt    DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

// â”€â”€â”€ Platform configuration â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

// Company/business/payment/security settings, one row per key, grouped for the
// settings UI. Values are Json so a setting can be a scalar or a small object
// without a migration per setting. The commission rate lives here rather than
// being hard-coded â€” Dine Inc.'s revenue model is not represented anywhere in
// the restaurant schema, and inventing a rate in code would silently fabricate
// every revenue figure the dashboard shows.
model PlatformSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  group       String
  value       Json
  description String?
  updatedById Int?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([group])
}

model FeatureFlag {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  name        String
  description String?
  isEnabled   Boolean  @default(false)
  updatedById Int?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

/// Persisted application errors, so the correlation id the API hands an
/// employee actually resolves to something.
///
/// Until now every unexpected failure was console.error'd to stdout — captured
/// by the host, invisible to the console, and unsearchable. The error response
/// tells the employee to "quote this reference", so the reference has to lead
/// somewhere. This is that somewhere.
///
/// Deliberately errors only, not a general request log: logging every request
/// would put a write on the hot path and fill the table with noise. Stack
/// traces are stored because this table is only readable with LOG_VIEW, and a
/// stack is the whole point of an engineer opening it.
model ApplicationLog {
  id            Int      @id @default(autoincrement())
  correlationId String
  level         String   @default("ERROR")
  service       String   @default("internal-api")
  method        String?
  path          String?
  statusCode    Int?
  message       String
  stack         String?
  /// Set when the failure happened inside an authenticated internal request.
  actorId       Int?
  actorEmail    String?
  /// Entity ids parsed from the route, so a log line can be found by the order
  /// or restaurant it concerned rather than only by its correlation id.
  restaurantId  Int?
  orderId       Int?
  ip            String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([correlationId])
  @@index([createdAt])
  @@index([level, createdAt])
  @@index([restaurantId])
}

// ═══════════════════════════════════════════════════════════════════════════
// DineInk commercial model
//
// The company sells software to restaurants on subscription. Until now the
// console had no representation of that at all: `Restaurant` was doing duty as
// the customer, the product tenant and the commercial lifecycle all at once,
// which made "who is our customer", "what did they buy" and "are they paying"
// unanswerable questions.
//
// The entity that buys something is an Account. An Account owns one or more
// Restaurants (product tenants), each of which owns its Branches (outlets) —
// so a four-outlet group is one Account, not four customers.
//
//   Account ──┬── AccountContact
//             ├── Restaurant ── Branch          (the product tenants/outlets)
//             ├── Subscription ── Product/Plan
//             ├── Onboarding ── OnboardingTask
//             ├── Invoice ── InvoiceLine ── Payment / CreditNote
//             └── Opportunity
// ═══════════════════════════════════════════════════════════════════════════

/// Where an account sits commercially. Deliberately separate from onboarding
/// progress, from subscription health, and from whether an outlet is trading —
/// those are four independent questions that were previously one column.
enum AccountLifecycleStatus {
  LEAD
  PROSPECT
  CUSTOMER
  CHURNED
}

model Account {
  id          Int                    @id @default(autoincrement())
  accountCode String                 @unique /// ACC-0001 — quoted between employees
  name        String
  legalName   String?
  status      AccountLifecycleStatus @default(LEAD)

  /// Sales pipeline position. A free-form key rather than an enum because
  /// Dineink has not defined its stages; SalesStage below is the configurable
  /// list, and this points at one of its keys.
  salesStageKey String?

  /// The employee who owns this relationship commercially. Drives both the
  /// "my accounts" view and, with AccountAssignment, data scoping.
  ownerId Int?

  // Business and billing identity. Held on the account, not the restaurant:
  // the contracting party is the group, and its GST number is not an outlet's.
  gstNumber       String?
  billingEmail    String?
  billingPhone    String?
  billingAddress  String?
  city            String?
  state           String?
  pincode         String?
  website         String?
  industrySegment String?
  notes           String?

  becameCustomerAt DateTime?
  churnedAt        DateTime?
  churnReason      String?

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner         InternalUser?       @relation("AccountOwner", fields: [ownerId], references: [id])
  contacts      AccountContact[]
  restaurants   Restaurant[]
  subscriptions Subscription[]
  onboardings   Onboarding[]
  invoices      Invoice[]
  payments      Payment[]
  creditNotes   CreditNote[]
  assignments   AccountAssignment[]
  opportunities Opportunity[]
  lifecycleEvents AccountLifecycleEvent[]
  externalLinks   AccountExternalLink[]

  @@index([status])
  @@index([ownerId])
  @@index([name])
}

model AccountContact {
  id          Int     @id @default(autoincrement())
  accountId   Int
  name        String
  email       String?
  phone       String?
  designation String?
  /// Exactly one primary contact per account is enforced in the service, not by
  /// a constraint: a partial unique index would make "promote a different
  /// contact" order-dependent within the transaction.
  isPrimary   Boolean @default(false)
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([email])
}

/// Which employees may reach which accounts.
///
/// This is the mechanism behind data scoping: an employee whose role carries
/// ASSIGNED_ACCOUNTS scope sees only accounts they appear against here. Without
/// it every employee could read every customer, which was the largest
/// authorization gap in the console.
model AccountAssignment {
  id          Int      @id @default(autoincrement())
  accountId   Int
  employeeId  Int
  /// What they do on this account — ACCOUNT_MANAGER, ONBOARDING, SUPPORT, …
  /// Free text so a team convention can change without a migration.
  role        String?
  grantedById Int?
  createdAt   DateTime @default(now())

  account  Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  employee InternalUser @relation("AssignedAccounts", fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([accountId, employeeId])
  @@index([employeeId])
}

// ─── Products and plans ─────────────────────────────────────────────────────

enum ProductStatus {
  ACTIVE
  RETIRED
}

/// What Dineink sells. Seeded with DINEINK_DOT and DINEINK_RDS; a new product
/// is a row, not a code change.
model Product {
  id            Int           @id @default(autoincrement())
  key           String        @unique /// DINEINK_DOT, DINEINK_RDS
  name          String
  description   String?
  /// Who the product is aimed at. Copy for the console, not a rule.
  targetSegment String?
  status        ProductStatus @default(ACTIVE)
  sortOrder     Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plans         Plan[]
  subscriptions Subscription[]
  opportunities Opportunity[]

  @@index([status])
}

enum PlanStatus {
  ACTIVE
  RETIRED
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  ANNUAL
}

/// A purchasable tier of a product. RDS has Professional and Enterprise; Dot
/// currently has none, which is why Subscription.planId is nullable.
///
/// Every commercial term below is nullable and seeded unset. Dineink has not
/// defined pricing, trial length or billing cycle, and a plausible-looking
/// default would be indistinguishable from a real one once it reached a screen.
/// Null means "not configured yet" and every consumer renders it as such.
model Plan {
  id          Int        @id @default(autoincrement())
  productId   Int
  key         String /// PROFESSIONAL, ENTERPRISE
  name        String
  description String?
  status      PlanStatus @default(ACTIVE)
  sortOrder   Int        @default(0)

  /// Pricing — NOT YET DEFINED BY THE BUSINESS. Null, never zero: zero is a
  /// price, null is the absence of one.
  priceAmount     Decimal?         @db.Decimal(12, 2)
  currency        String?
  billingInterval BillingInterval?
  /// Trial length in days. Null = no trial policy defined for this plan.
  trialDays       Int?

  /// Entitlements. Null = undefined rather than unlimited; the distinction is
  /// recorded in entitlementNotes rather than guessed at.
  includedLocations Int?
  includedSeats     Int?
  entitlementNotes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  opportunities Opportunity[]

  @@unique([productId, key])
  @@index([status])
}

// ─── Subscriptions ──────────────────────────────────────────────────────────

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  EXPIRED
}

model Subscription {
  id               Int                @id @default(autoincrement())
  subscriptionCode String             @unique /// SUB-0001
  accountId        Int
  productId        Int
  /// Null when the product has no plans (Dineink Dot today). The service
  /// requires one whenever the product has active plans.
  planId           Int?
  status           SubscriptionStatus @default(TRIAL)

  startDate          DateTime
  /// Copied from the plan at creation so a later plan change does not silently
  /// rewrite an existing agreement. Null while undefined.
  billingInterval    BillingInterval?
  trialEndsAt        DateTime?
  renewalDate        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  /// Contracted quantities for this account, which may differ from the plan's
  /// defaults. Null = not specified.
  seats     Int?
  locations Int?

  cancelledAt        DateTime?
  cancellationReason String?
  endedAt            DateTime?
  notes              String?

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  plan    Plan?   @relation(fields: [planId], references: [id])

  events       SubscriptionEvent[]
  invoices     Invoice[]
  invoiceLines InvoiceLine[]
  onboardings  Onboarding[]

  @@index([accountId])
  @@index([status])
  @@index([productId, planId])
  @@index([renewalDate])
}

/// The subscription's own history — status moves, plan changes, cancellation.
/// Separate from the audit log: this is domain history the account timeline is
/// built from, and it reads without AUDIT_VIEW.
model SubscriptionEvent {
  id             Int      @id @default(autoincrement())
  subscriptionId Int
  type           String /// CREATED, STATUS_CHANGED, PLAN_CHANGED, CANCELLED, RENEWED
  fromValue      String?
  toValue        String?
  message        String?
  actorId        Int?
  createdAt      DateTime @default(now())

  subscription Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  actor        InternalUser? @relation("SubscriptionEventActor", fields: [actorId], references: [id])

  @@index([subscriptionId, createdAt])
}

// ─── Billing ────────────────────────────────────────────────────────────────
//
// Restaurants pay DineInk. This is deliberately NOT the `Bill` model, which is
// a diner paying a restaurant — the two were previously conflated in the
// dashboard's revenue framing.
//
// No payment gateway is integrated and none is assumed. Invoices and payments
// are recorded by Finance; the model is shaped so a gateway can populate the
// same rows later without a migration.

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

model Invoice {
  id             Int           @id @default(autoincrement())
  invoiceNo      String        @unique /// INV-0001
  accountId      Int
  subscriptionId Int?
  status         InvoiceStatus @default(DRAFT)

  issueDate   DateTime?
  dueDate     DateTime?
  periodStart DateTime?
  periodEnd   DateTime?

  /// Decimal, not Float. Money in a binary float accumulates error that
  /// surfaces as a rupee missing from a reconciliation nobody can explain.
  subtotal   Decimal  @default(0) @db.Decimal(12, 2)
  /// Tax as charged. Dineink has not defined its rates, so nothing computes
  /// this — it is entered with the invoice.
  taxAmount  Decimal? @db.Decimal(12, 2)
  taxNotes   String?
  total      Decimal  @default(0) @db.Decimal(12, 2)
  amountPaid Decimal  @default(0) @db.Decimal(12, 2)
  currency   String   @default("INR")

  notes      String?
  voidedAt   DateTime?
  voidReason String?

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  lines        InvoiceLine[]
  payments     Payment[]
  creditNotes  CreditNote[]

  @@index([accountId, status])
  @@index([status, dueDate])
  @@index([issueDate])
}

model InvoiceLine {
  id             Int     @id @default(autoincrement())
  invoiceId      Int
  subscriptionId Int?
  description    String
  quantity       Decimal @default(1) @db.Decimal(12, 2)
  unitAmount     Decimal @db.Decimal(12, 2)
  amount         Decimal @db.Decimal(12, 2)
  sortOrder      Int     @default(0)

  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([invoiceId])
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id        Int           @id @default(autoincrement())
  paymentNo String        @unique /// PAY-0001
  accountId Int
  invoiceId Int?
  amount    Decimal       @db.Decimal(12, 2)
  currency  String        @default("INR")
  status    PaymentStatus @default(SUCCEEDED)
  /// How it arrived — BANK_TRANSFER, UPI, CHEQUE, … Free text because no
  /// gateway is integrated and the list is an operational convention.
  method        String?
  reference     String?
  receivedAt    DateTime
  failureReason String?
  notes         String?

  recordedById Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([accountId])
  @@index([invoiceId])
  @@index([status, receivedAt])
}

enum CreditNoteStatus {
  ISSUED
  APPLIED
  VOID
}

/// A credit against an invoice — the SaaS equivalent of a refund. Named for
/// what it is rather than reusing "refund", which in this codebase already
/// means a restaurant refunding a diner (`BillRefund`).
model CreditNote {
  id           Int              @id @default(autoincrement())
  creditNoteNo String           @unique /// CN-0001
  accountId    Int
  invoiceId    Int?
  amount       Decimal          @db.Decimal(12, 2)
  currency     String           @default("INR")
  status       CreditNoteStatus @default(ISSUED)
  reason       String
  issuedAt     DateTime
  createdById  Int?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  account Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([accountId])
  @@index([invoiceId])
}

// ─── Onboarding (account-scoped) ────────────────────────────────────────────
//
// Replaces the restaurant-scoped checklist. Onboarding is something a customer
// goes through after buying, so it hangs off the account and optionally off the
// subscription that triggered it.

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  READY_FOR_GO_LIVE
  LIVE
  COMPLETED
}

model Onboarding {
  id             Int              @id @default(autoincrement())
  accountId      Int
  subscriptionId Int?
  status         OnboardingStatus @default(NOT_STARTED)

  assignedToId Int?
  startedAt    DateTime?
  dueDate      DateTime?
  goLiveAt     DateTime?
  completedAt  DateTime?

  blockedReason String?
  notes         String?

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account      Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  subscription Subscription?     @relation(fields: [subscriptionId], references: [id])
  assignedTo   InternalUser?     @relation("OnboardingAssignee", fields: [assignedToId], references: [id])
  tasks        OnboardingTask[]
  events       OnboardingEvent[]

  @@index([accountId])
  @@index([status])
  @@index([assignedToId])
}

model OnboardingTask {
  id            Int                  @id @default(autoincrement())
  onboardingId  Int
  key           String
  label         String
  category      String
  isMandatory   Boolean              @default(true)
  status        OnboardingTaskStatus @default(PENDING)
  notes         String?
  sortOrder     Int                  @default(0)
  dueDate       DateTime?
  assignedToId  Int?
  completedAt   DateTime?
  completedById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  onboarding  Onboarding    @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  assignedTo  InternalUser? @relation("OnboardingTaskAssignee", fields: [assignedToId], references: [id])
  completedBy InternalUser? @relation("OnboardingTaskCompleter", fields: [completedById], references: [id])

  @@unique([onboardingId, key])
  @@index([onboardingId, status])
}

model OnboardingEvent {
  id           Int      @id @default(autoincrement())
  onboardingId Int
  type         String /// STATUS_CHANGED, TASK_UPDATED, ASSIGNED, BLOCKED, NOTE
  fromValue    String?
  toValue      String?
  message      String?
  actorId      Int?
  createdAt    DateTime @default(now())

  onboarding Onboarding    @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  actor      InternalUser? @relation("OnboardingEventActor", fields: [actorId], references: [id])

  @@index([onboardingId, createdAt])
}

/// Per-product onboarding templates. Dot and RDS Enterprise will not need the
/// same steps, and the previous template was a hard-coded array. Seeded with
/// the existing twelve steps as the default (productId null) so nothing is
/// invented; a product-specific template is a row, not a migration.
model OnboardingTemplateTask {
  id          Int      @id @default(autoincrement())
  productId   Int?
  key         String
  label       String
  category    String
  isMandatory Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productId, key])
  @@index([productId])
}

// ─── Sales pipeline (lightweight) ───────────────────────────────────────────
//
// Deliberately small. Leads and prospects are Accounts in a pre-customer
// lifecycle state rather than a parallel entity, so converting a lead loses
// nothing and duplicates nothing. Only the deal itself needs its own row.

/// The pipeline, as configuration. Dineink has not ratified its stages, so the
/// seeded list is the one from the brief and is editable without a migration.
model SalesStage {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  name      String
  sortOrder Int      @default(0)
  /// Marks terminal stages so conversion and win-rate can be computed without
  /// hard-coding stage names in queries.
  isWon     Boolean  @default(false)
  isLost    Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunities Opportunity[]
}

model Opportunity {
  id        Int    @id @default(autoincrement())
  accountId Int
  name      String
  stageId   Int
  ownerId   Int?
  /// Interest, not entitlement — which product/plan the deal is for.
  productId Int?
  planId    Int?
  /// Deal value. Null because Dineink has not supplied pricing; entered by
  /// sales when known rather than derived from a plan price that does not exist.
  amount            Decimal?  @db.Decimal(12, 2)
  currency          String?
  expectedCloseDate DateTime?
  closedAt          DateTime?
  lostReason        String?
  notes             String?

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  stage   SalesStage    @relation(fields: [stageId], references: [id])
  owner   InternalUser? @relation("OpportunityOwner", fields: [ownerId], references: [id])
  product Product?      @relation(fields: [productId], references: [id])
  plan    Plan?         @relation(fields: [planId], references: [id])

  @@index([accountId])
  @@index([stageId])
  @@index([ownerId])
}

// ─── Background work ────────────────────────────────────────────────────────
//
// A durable job queue in Postgres rather than Redis + BullMQ.
//
// This deployment has no Redis and runs a single `node dist/server.js`. Adding
// a broker would mean a new service to run, monitor and pay for, to carry a
// handful of jobs that are neither high-throughput nor latency-sensitive:
// syncing a Jira status, retrying a failed integration call, tidying expired
// sessions. Postgres already provides durability, transactions and — via
// `FOR UPDATE SKIP LOCKED` — safe concurrent claiming across instances.
//
// The trade-off is real and worth stating: polling costs a query per interval,
// and this will not scale to thousands of jobs a second. At that point a broker
// earns its keep. Nothing here is hard to migrate — handlers take a payload and
// return; only the claiming changes.

enum BackgroundJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  /// Failed but still has attempts left; `runAt` holds the backoff time.
  FAILED
  /// Out of attempts. Left in place deliberately — a dead job is evidence, and
  /// deleting it would hide a broken integration.
  DEAD
}

model BackgroundJob {
  id      Int                 @id @default(autoincrement())
  type    String
  payload Json
  status  BackgroundJobStatus @default(PENDING)

  attempts    Int @default(0)
  maxAttempts Int @default(5)

  /// When this becomes eligible to run. Also the backoff mechanism: a failed
  /// job is rescheduled by pushing this forward.
  runAt DateTime @default(now())

  /// Set while a worker holds the job. `lockedBy` identifies which one, so a
  /// job stuck RUNNING after a crash can be attributed and reclaimed.
  lockedAt DateTime?
  lockedBy String?

  lastError   String?
  completedAt DateTime?

  /// Optional de-duplication handle. A unique index means "sync ticket 42's
  /// Jira status" cannot be queued twice while one is already pending.
  dedupeKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dedupeKey])
  @@index([status, runAt])
  @@index([type, status])
}

/// The account's commercial history.
///
/// Retention was previously computed as "joined in month X and their status is
/// CUSTOMER *today*", which cannot see a customer who left and came back, and
/// cannot answer "how many customers did we have last March". The subscription
/// side already had SubscriptionEvent; the account side had nothing.
///
/// Written by `setAccountLifecycle` and by the sales pipeline when a deal is
/// won, in the same transaction as the change itself — so the history cannot
/// disagree with the row it describes.
///
/// `isBackfilled` marks the single synthetic row each pre-existing account
/// received when this table was introduced. Those rows carry the account's
/// creation date because that is genuinely all that was known; analytics
/// excludes them from point-in-time answers rather than treating a made-up
/// date as history.
model AccountLifecycleEvent {
  id        Int                    @id @default(autoincrement())
  accountId Int
  fromStatus AccountLifecycleStatus?
  toStatus  AccountLifecycleStatus
  reason    String?
  actorId   Int?
  /// True only for rows created by the migration that introduced this table.
  isBackfilled Boolean @default(false)
  createdAt DateTime @default(now())

  account Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  actor   InternalUser? @relation("AccountLifecycleActor", fields: [actorId], references: [id])

  @@index([accountId, createdAt])
  @@index([toStatus, createdAt])
}

/// Which system a linked record lives in.
enum ExternalSystem {
  /// Dineink RDS — the restaurant product in this database. A link is not
  /// strictly needed (Restaurant.accountId already exists) but recording it
  /// keeps one uniform way to ask "what does this customer run".
  DINEINK_RDS
  /// Dineink Dot — a separate application with its own database, its own Shop
  /// model (UUID keys, phone-based identity) and no shared schema.
  DINEINK_DOT
}

/// A pointer from a DinkDesk account to a record in another Dineink system.
///
/// WHY A POINTER AND NOT A COPY
/// Dineink Dot runs on its own Postgres (`dineink_dot`), with `Shop` keyed by
/// UUID and identified by phone number. Nothing is shared with RDS — not the
/// database, not the identifier space, not the auth. Copying Dot's shops,
/// orders or khata entries into this database would create a second source of
/// truth that goes stale the moment anyone uses the Dot app.
///
/// So DinkDesk records only the link: "account ACC-0007's Dot shop is
/// <uuid>". Commercial facts — who they are, what they pay, their onboarding —
/// live here, because those are DinkDesk's business. Operational facts stay in
/// Dot, and are read over an API when Dot exposes one.
///
/// WHAT THIS DELIBERATELY DOES NOT DO
/// It does not verify that the external id exists. Dot has no API to ask, and
/// a link to a shop that was deleted is a data-quality problem to surface, not
/// something to prevent by guessing. `verifiedAt` records when a link was last
/// confirmed against the other system; null means never.
model AccountExternalLink {
  id         Int            @id @default(autoincrement())
  accountId  Int
  system     ExternalSystem
  /// The other system's primary key, as text — Dot uses UUIDs, RDS uses ints,
  /// and a future product may use something else again.
  externalId String
  /// Human-readable label from the other system, cached for display so the
  /// console can show a name without a cross-system call on every page load.
  externalLabel String?
  /// When this link was last confirmed to point at something real. Null means
  /// it has never been checked — which is the honest state today, because Dot
  /// exposes nothing to check against.
  verifiedAt DateTime?
  notes      String?

  linkedById Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// One link per record per system: the same Dot shop must not be claimed by
  /// two accounts.
  @@unique([system, externalId])
  @@index([accountId])
}
